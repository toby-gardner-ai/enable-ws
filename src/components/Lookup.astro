---
// Sticky search box and A–Z bar that filter the [data-entry] items on the page.
// Each entry carries data-search (lowercase text to match) and data-tags;
// each letter group is a [data-group] element with id `letter-x`.
interface Props {
  placeholder: string;
  noun: [string, string]; // singular, plural
  letters: string[]; // letters that have entries
  filters?: { label: string; tag: string }[];
}
const { placeholder, noun, letters, filters = [] } = Astro.props;
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---
<div class="lookup" data-singular={noun[0]} data-plural={noun[1]}>
  <div class="container">
    <div class="search-row">
      <label class="search">
        <span class="visually-hidden">Search</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="lookup-input" type="search" placeholder={placeholder} autocomplete="off" />
        <kbd>/</kbd>
      </label>
      {filters.length > 0 && (
        <div class="chips" role="group" aria-label="Filter">
          <button type="button" class="chip" aria-pressed="true" data-filter="">All</button>
          {filters.map((f) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={f.tag}>{f.label}</button>
          ))}
        </div>
      )}
      <p class="count" aria-live="polite" id="lookup-count"></p>
    </div>
    <nav class="az" aria-label="Jump to letter">
      {alphabet.map((l) =>
        letters.includes(l) ? <a href={`#letter-${l.toLowerCase()}`}>{l}</a> : <span aria-hidden="true">{l}</span>
      )}
    </nav>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.lookup')!;
  const input = document.getElementById('lookup-input') as HTMLInputElement;
  const count = document.getElementById('lookup-count')!;
  const empty = document.getElementById('lookup-empty');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const { singular, plural } = root.dataset;
  let filter = '';

  function apply() {
    const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const entry of entries) {
      const text = entry.dataset.search ?? '';
      const tagged = !filter || (entry.dataset.tags ?? '').split(' ').includes(filter);
      const match = tagged && words.every((w) => text.includes(w));
      entry.hidden = !match;
      if (match) shown++;
    }
    for (const group of groups) {
      group.hidden = !group.querySelector('[data-entry]:not([hidden])');
    }
    // Disable letters with nothing left to jump to.
    root.querySelectorAll<HTMLAnchorElement>('.az a').forEach((a) => {
      const group = document.querySelector<HTMLElement>(a.getAttribute('href')!);
      a.classList.toggle('off', !group || group.hidden);
    });
    const total = entries.length;
    count.textContent =
      shown === total ? `${total} ${plural}` : `${shown} of ${total} ${shown === 1 ? singular : plural}`;
    if (empty) empty.hidden = shown > 0;
  }

  input.addEventListener('input', apply);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    }),
  );
  // Press "/" anywhere to jump to the search box.
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (e.key === '/' && !/INPUT|TEXTAREA/.test(target.tagName)) {
      e.preventDefault();
      input.focus();
    }
  });
  document.getElementById('lookup-clear')?.addEventListener('click', () => {
    input.value = '';
    chips[0]?.click();
    apply();
    input.focus();
  });
  apply();
</script>

<style>
  .lookup {
    position: sticky; top: 4rem; z-index: 4;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--border);
    padding: 0.9rem 0 0.6rem;
  }
  .search-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem 1rem; }
  .search {
    flex: 1 1 18rem; display: flex; align-items: center; gap: 0.6rem;
    border: 1px solid var(--border); border-radius: 999px; background: var(--bg);
    padding: 0.55rem 0.9rem; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent); }
  .search svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; flex: none; }
  .search input { flex: 1; min-width: 0; border: 0; background: none; color: var(--text); font: inherit; outline: none; }
  .search input::-webkit-search-cancel-button { cursor: pointer; }
  kbd {
    font: 600 0.75rem var(--font); color: var(--muted);
    border: 1px solid var(--border); border-radius: 6px; padding: 0.05rem 0.45rem;
  }
  .chips { display: flex; gap: 0.4rem; }
  .chip {
    font: inherit; font-size: 0.85rem; cursor: pointer;
    padding: 0.35rem 0.85rem; border-radius: 999px;
    border: 1px solid var(--border); background: var(--bg); color: var(--muted);
  }
  .chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-contrast); }
  .count { margin: 0 0 0 auto; font-size: 0.88rem; color: var(--muted); white-space: nowrap; }
  .az { display: flex; flex-wrap: wrap; gap: 0.15rem; margin-top: 0.6rem; }
  .az a, .az span {
    display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem;
    border-radius: 6px; font-size: 0.82rem; font-weight: 600; text-decoration: none;
  }
  .az a:hover { background: var(--bg-soft); }
  .az span, .az a.off { color: var(--border) !important; pointer-events: none; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 760px) {
    .lookup { position: static; }
    kbd { display: none; }
  }
</style>
