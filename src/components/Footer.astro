---
import { SITE } from '../config';
const year = new Date().getFullYear();
---
<footer>
  <div class="container foot">
    <p class="muted">© {year} {SITE.name}. Helping teams turn AI into results.</p>
    <ul>
      <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={SITE.github} rel="me">GitHub</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--border); padding: 2rem 0; font-size: 0.92rem; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; align-items: center; }
  .foot p { margin: 0; }
  ul { display: flex; gap: 1.2rem; list-style: none; margin: 0; padding: 0; }
</style>
