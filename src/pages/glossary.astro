---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Lookup from '../components/Lookup.astro';
import glossary from '../data/glossary.json';
import { byFirstLetter, inline, plain } from '../lib/inline';

// Generated by `npm run extract:governance` from the Governance Subject Register.
const groups = byFirstLetter(glossary, (t) => t.term);
const letters = groups.map(([letter]) => letter);
---
<Base title="AI Governance Glossary" description="Plain-English meanings of the terms used in AI governance: agents, bundles, guardrails, installations, tenants and more.">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">AI Enablement · Glossary</span>
      <h1>Know what every AI governance word means</h1>
      <p class="lead">
        The terms that come up when you put AI agents into production, explained in plain English.
        Type a word and the matches appear as you type.
      </p>
    </div>
  </section>

  <Lookup placeholder="Look up a term, e.g. bundle or tenant" noun={['term', 'terms']} letters={letters} />

  <section class="list-section">
    <div class="container">
      {groups.map(([letter, terms]) => (
        <div class="group" id={`letter-${letter.toLowerCase()}`} data-group>
          <h2 class="letter">{letter}</h2>
          <dl>
            {terms.map((t) => (
              <div class="term" id={t.slug} data-entry data-search={plain(`${t.term} ${t.meaning}`).toLowerCase()}>
                <dt><a href={`#${t.slug}`}>{t.term}</a></dt>
                <dd set:html={inline(t.meaning)} />
              </div>
            ))}
          </dl>
        </div>
      ))}
      <div id="lookup-empty" class="empty" hidden>
        <p>No term matches that search.</p>
        <button type="button" id="lookup-clear" class="btn btn-ghost">Clear search</button>
      </div>
      <p class="see-also">
        Want to know what these terms are governed for? <a href="/subjects">Browse the governance subjects →</a>
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-bottom: 2.5rem; }
  .list-section { padding-top: 1.5rem; }
  .group { scroll-margin-top: 12rem; }
  .letter {
    font-size: 1.5rem; color: var(--accent-strong);
    border-bottom: 1px solid var(--border); padding: 1.6rem 0 0.5rem; margin: 0;
  }
  :root[data-theme='dark'] .letter { color: var(--accent); }
  dl { margin: 0; }
  .term {
    display: grid; grid-template-columns: minmax(10rem, 15rem) 1fr; gap: 0.4rem 2rem;
    padding: 1.1rem 0; border-bottom: 1px solid var(--border);
    scroll-margin-top: 12rem;
  }
  .term:target { background: var(--bg-soft); box-shadow: -1rem 0 0 var(--bg-soft), 1rem 0 0 var(--bg-soft); }
  dt { font-weight: 700; }
  dt a { color: var(--text) !important; text-decoration: none; }
  dt a:hover { color: var(--accent-strong) !important; }
  dd { margin: 0; color: var(--muted); max-width: 65ch; }
  dd :global(code) { font-size: 0.88em; background: var(--bg-soft); padding: 0.05rem 0.35rem; border-radius: 5px; color: var(--text); }
  .empty { text-align: center; padding: 3rem 0; color: var(--muted); }
  .see-also { margin-top: 2.5rem; color: var(--muted); }
  @media (max-width: 640px) {
    .term { grid-template-columns: 1fr; }
  }
</style>
