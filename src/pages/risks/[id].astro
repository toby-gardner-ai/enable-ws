---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import {
  CIA_LABEL,
  LEVEL_LABEL,
  assetTitle,
  controlById,
  levelOf,
  riskHref,
  risks,
  scales,
  threatRef,
  type Risk,
} from '../../lib/risks';
import { KIND_ICON, KIND_LABEL, controlHref, withControlLinks } from '../../lib/controls';

export function getStaticPaths() {
  return risks.map((risk) => ({ params: { id: riskHref(risk).split('/').pop() }, props: { risk } }));
}

const { risk } = Astro.props as { risk: Risk };
const index = risks.indexOf(risk);
const prev = risks[index - 1];
const next = risks[index + 1];
const asset = assetTitle(risk.asset);
const others = risks.filter((r) => r.asset === risk.asset && r !== risk).slice(0, 6);
const controls = risk.controls.map(controlById).filter((c): c is NonNullable<typeof c> => !!c);
const dated = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const rated = (when: 'inherent' | 'residual') => risk[when];
const moved = risk.inherent.level !== risk.residual.level || risk.inherent.likelihood !== risk.residual.likelihood || risk.inherent.impact !== risk.residual.impact;
---
<Base title={`${risk.title} · AI Risk Map`} description={risk.text ?? `${risk.title}: an AI risk to ${asset.toLowerCase()}, rated before and after controls.`}>
  <article>
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/controls">AI Controls</a><span aria-hidden="true">/</span>
          <a href="/risks">Risk Map</a><span aria-hidden="true">/</span>
          <a href={`/risks#asset-${risk.asset}`}>{asset}</a>
        </nav>
        <p class="meta">
          <span class="asset-tag">Risk to {asset.toLowerCase()}</span>
          {risk.cia.map((c) => <span class="tag">{CIA_LABEL[c]}</span>)}
        </p>
        <h1>{risk.title}</h1>
        {risk.text && (
          <div class="summary">
            <p set:html={withControlLinks(risk.text)} />
          </div>
        )}
        <nav class="pager" aria-label="Other risks">
          {prev ? <a href={riskHref(prev)} class="prev"><span>← Previous</span>{prev.title}</a> : <span />}
          {next && <a href={riskHref(next)} class="next"><span>Next →</span>{next.title}</a>}
        </nav>
      </div>
    </section>

    <section class="block soft">
      <div class="container">
        <h2>Before and after controls.</h2>
        <div class="compare">
          {(['inherent', 'residual'] as const).map((when, k) => (
            <>
              {k === 1 && <span class="compare-arrow" aria-hidden="true">→</span>}
              <div class="card rating">
                <p class="r-top">
                  <span class="r-when">{when === 'inherent' ? 'Without controls' : 'With controls'}</span>
                  <span class={`lvl lvl-${rated(when).level}`}>{LEVEL_LABEL[rated(when).level]}</span>
                </p>
                <div class="mini" role="img" aria-label={`Likelihood ${rated(when).likelihood} of 3, impact ${rated(when).impact} of 3`}>
                  {[3, 2, 1].map((i) =>
                    [1, 2, 3].map((l) => (
                      <span class:list={['m-cell', `lvl-${levelOf(l, i)}`, { on: rated(when).likelihood === l && rated(when).impact === i }]}></span>
                    )),
                  )}
                </div>
                <dl>
                  <dt>Likelihood</dt>
                  <dd>{rated(when).likelihood} · {scales.likelihood[rated(when).likelihood - 1].text}</dd>
                  <dt>Impact</dt>
                  <dd>{rated(when).impact} · {scales.impact[rated(when).impact - 1].short}</dd>
                </dl>
              </div>
            </>
          ))}
        </div>
        <p class="muted compare-note">
          {moved
            ? 'With controls is rated as if every control below works as designed.'
            : 'Controls don\'t lower this rating yet; see why above.'}
        </p>
      </div>
    </section>

    {risk.scenarios.length > 0 && (
      <section class="block">
        <div class="container">
          <h2>How it can happen.</h2>
          <ol class="scenarios">
            {risk.scenarios.map((s, i) => (
              <li class="card scenario">
                <span class="s-num" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  {s.text && <p set:html={withControlLinks(s.text)} />}
                  <p class="s-meta">
                    {s.observed && <span class="badge seen">Seen in practice · {dated(s.observed)}</span>}
                    {s.controls.length ? (
                      <span class="covered">
                        Covered by
                        {s.controls.map((id) => <a href={controlHref(id)} class="ctl-id">{id}</a>)}
                      </span>
                    ) : (
                      <span class="badge gap">Not yet covered by any control</span>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <section class="block tight">
      <div class="container two-col">
        <h2>{risk.decision ? 'Accepted, for now.' : 'Controls that reduce it.'}</h2>
        {risk.decision ? (
          <div class="card decision">
            <p>{risk.decision.reason}.</p>
            <dl>
              {risk.decision.by && (<><dt>Accepted by</dt><dd>{risk.decision.by}</dd></>)}
              {risk.decision.trigger && (<><dt>Reopened when</dt><dd>{risk.decision.trigger.charAt(0).toLowerCase() + risk.decision.trigger.slice(1)}</dd></>)}
              {risk.decision.reviewBy && (<><dt>Reviewed by</dt><dd>{dated(risk.decision.reviewBy)}</dd></>)}
            </dl>
          </div>
        ) : controls.length ? (
          <ul class="controls">
            {controls.map((c) => (
              <li>
                <a href={controlHref(c)}>
                  <span class="ctl-id">{c.id}</span>
                  <span>{c.title}</span>
                  <span class="c-kind"><span aria-hidden="true">{KIND_ICON[c.kind]}</span> {KIND_LABEL[c.kind]}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="card no-control">
            <p><strong>No control covers this risk yet.</strong> It stays at {LEVEL_LABEL[risk.residual.level].toLowerCase()} until one is designed and built.</p>
          </div>
        )}
      </div>
    </section>

    {risk.arisesFrom.length > 0 && (
      <section class="block tight">
        <div class="container two-col">
          <h2 class="small-h">Where it comes from.</h2>
          <div>
            <p class="muted">This risk to {asset.toLowerCase()} arises from:</p>
            <div class="chips">
              {risk.arisesFrom.map((a) => <a class="chip" href={`/risks#asset-${a}`}>{assetTitle(a)}</a>)}
            </div>
          </div>
        </div>
      </section>
    )}

    {risk.refs.length > 0 && (
      <section class="block tight">
        <div class="container two-col">
          <h2 class="small-h">Also known as.</h2>
          <div class="refs">
            {risk.refs.map(threatRef).map((ref) =>
              ref.href ? (
                <a class="ref" href={ref.href} target="_blank" rel="noopener"><span>{ref.catalogue}</span><strong>{ref.label} ↗</strong></a>
              ) : (
                <span class="ref"><span>{ref.catalogue}</span><strong>{ref.label}</strong></span>
              ),
            )}
          </div>
        </div>
      </section>
    )}

    {others.length > 0 && (
      <section class="block tight">
        <div class="container two-col">
          <h2 class="small-h">Other risks to {asset.toLowerCase()}.</h2>
          <ul class="others">
            {others.map((r) => (
              <li>
                <a href={riskHref(r)}>
                  <span>{r.title}</span>
                  <span class={`lvl lvl-${r.residual.level}`}>{LEVEL_LABEL[r.residual.level]}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="block tight">
      <div class="container">
        <div class="card stuck">
          <div>
            <h2>See the whole picture.</h2>
            <p class="muted">Every AI risk on one matrix, before and after controls.</p>
          </div>
          <div class="btn-row">
            <a href="/risks" class="btn btn-primary">Risk map →</a>
            <a href="/controls" class="btn btn-ghost">Control lifecycle</a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <CtaBand heading="Want to know which of these risks apply to you?" text="A 30 minute call to map the risks that matter for your AI use, and the controls that bring them down." />
</Base>

<style>
  .hero { padding-bottom: 2.5rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.88rem; color: var(--muted); margin-bottom: 1.8rem; }
  .crumbs a { color: var(--muted) !important; text-decoration: none; }
  .crumbs a:hover { color: var(--text) !important; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; }
  .meta .tag { margin: 0; }
  .asset-tag { font-size: 0.85rem; font-weight: 600; color: var(--g-asset); }
  h1 { max-width: 26ch; font-size: clamp(2rem, 4.2vw, 3rem); }
  .summary {
    margin-top: 1.4rem; padding: 1.5rem 1.7rem; max-width: 52rem;
    border: 1px solid var(--border); border-left: 4px solid var(--risk-high); border-radius: var(--radius); background: var(--bg-soft);
  }
  .summary p { font-size: 1.12rem; line-height: 1.65; margin: 0; }
  .summary :global(code), .scenario :global(code) { font-size: 0.86em; background: var(--bg); padding: 0.05rem 0.35rem; border-radius: 5px; border: 1px solid var(--border); }
  .pager { display: flex; justify-content: space-between; gap: 1rem; max-width: 52rem; margin-top: 1.2rem; }
  .pager a { display: grid; max-width: 48%; font-weight: 600; text-decoration: none; color: var(--text) !important; font-size: 0.92rem; }
  .pager a span { font-size: 0.8rem; font-weight: 500; color: var(--muted); }
  .pager a:hover { color: var(--accent-strong) !important; }
  .pager .next { text-align: right; }

  .block { padding: clamp(2.5rem, 6vw, 4rem) 0; }
  .block.tight { padding-top: 0; }
  .two-col { display: grid; grid-template-columns: 15rem 1fr; gap: 1rem 3rem; align-items: start; }
  .two-col h2 { font-size: 1.6rem; }
  .small-h { font-size: 1.15rem !important; padding-top: 0.3rem; }

  .compare { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; max-width: 46rem; margin-top: 1.2rem; }
  .compare-arrow { font-size: 1.6rem; color: var(--accent); }
  .rating { display: grid; gap: 0.9rem; }
  .r-top { display: flex; justify-content: space-between; align-items: center; margin: 0; }
  .r-when { font-weight: 700; }
  .mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; width: 9rem; }
  .m-cell { aspect-ratio: 1.3; border-radius: 5px; background: color-mix(in srgb, var(--lvl) 14%, var(--bg)); border: 1px solid color-mix(in srgb, var(--lvl) 30%, transparent); }
  .m-cell.on { background: var(--lvl); box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--lvl); }
  .rating dl { margin: 0; font-size: 0.88rem; }
  .rating dt { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .rating dd { margin: 0.1rem 0 0.5rem; }
  .compare-note { font-size: 0.88rem; margin-top: 1rem; }

  .scenarios { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; gap: 1rem; }
  .scenario { display: grid; grid-template-columns: auto 1fr; gap: 1rem; }
  .s-num { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; background: var(--bg-soft); font-weight: 700; }
  .scenario h3 { font-size: 1.08rem; margin-bottom: 0.4rem; }
  .scenario p { color: var(--muted); font-size: 0.95rem; max-width: 70ch; }
  .s-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin: 0.4rem 0 0 !important; }
  .covered { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; font-size: 0.82rem; }
  .covered .ctl-id { text-decoration: none; }
  .covered .ctl-id:hover { border-color: var(--accent); }
  .badge { font-size: 0.78rem; font-weight: 600; padding: 0.15rem 0.6rem; border-radius: 999px; }
  .seen { background: color-mix(in srgb, var(--g-subject) 14%, transparent); color: var(--text); }
  .gap { background: color-mix(in srgb, var(--risk-high) 14%, transparent); color: var(--text); }
  .gap::before { content: '! '; font-weight: 800; color: var(--risk-high); }

  .controls { list-style: none; padding: 0; margin: 0; }
  .controls li + li { border-top: 1px solid var(--border); }
  .controls a { display: grid; grid-template-columns: 5rem 1fr 8rem; gap: 1rem; align-items: baseline; padding: 0.7rem 0.3rem; text-decoration: none; color: var(--text) !important; border-radius: 8px; }
  .controls a:hover { background: var(--bg-soft); }
  .controls .ctl-id { justify-self: start; }
  .c-kind { font-size: 0.82rem; color: var(--muted); }
  .decision { border-left: 4px solid var(--risk-medium); }
  .decision p { margin-bottom: 1rem; }
  .decision dl { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; margin: 0; font-size: 0.92rem; }
  .decision dt { font-weight: 600; color: var(--muted); }
  .decision dd { margin: 0; }
  .no-control { border-left: 4px solid var(--risk-high); }
  .no-control p { margin: 0; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { padding: 0.4rem 0.95rem; border-radius: 999px; border: 1px solid var(--border); font-size: 0.9rem; text-decoration: none; color: var(--text) !important; }
  .chip:hover { border-color: var(--accent); }
  .refs { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .ref { display: grid; padding: 0.5rem 0.9rem; border-radius: 10px; border: 1px solid var(--border); text-decoration: none; color: var(--text) !important; }
  .ref span { font-size: 0.72rem; color: var(--muted); }
  .ref strong { font: 600 0.9rem ui-monospace, Menlo, monospace; }
  a.ref:hover { border-color: var(--accent); }
  .others { list-style: none; padding: 0; margin: 0; }
  .others li + li { border-top: 1px solid var(--border); }
  .others a { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 0.65rem 0.3rem; text-decoration: none; color: var(--text) !important; border-radius: 8px; }
  .others a:hover { background: var(--bg-soft); }

  .stuck { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; padding: 2rem; background: var(--bg-soft); }
  .stuck h2 { font-size: 1.5rem; margin-bottom: 0.3rem; }
  .stuck p { margin: 0; }
  .stuck .btn-row { margin-top: 0; }

  @media (max-width: 760px) {
    .two-col { grid-template-columns: 1fr; }
    .compare { grid-template-columns: 1fr; }
    .compare-arrow { transform: rotate(90deg); justify-self: center; }
    .controls a { grid-template-columns: auto 1fr; }
    .c-kind { display: none; }
    .pager a { max-width: 100%; }
  }
</style>
