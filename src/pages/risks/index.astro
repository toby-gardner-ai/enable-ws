---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Lookup from '../../components/Lookup.astro';
import GraphBand from '../../components/GraphBand.astro';
import { CIA_LABEL, LEVELS, LEVEL_LABEL, assetTitle, assets, count, levelOf, riskHref, risks, scales, type Risk } from '../../lib/risks';
import { plain } from '../../lib/inline';

// Generated by `npm run extract:risks` from the Risk Register, the Control Graph and the risk method.
const scenarioCount = risks.reduce((n, r) => n + r.scenarios.length, 0);
const cell = (r: Risk, when: 'inherent' | 'residual') => `${r[when].likelihood}-${r[when].impact}`;
const inCell = (when: 'inherent' | 'residual', l: number, i: number) =>
  risks.filter((r) => r[when].likelihood === l && r[when].impact === i).length;
const highBefore = count('high', 'inherent');
const highAfter = count('high', 'residual');
const stillHigh = risks.filter((r) => r.residual.level === 'high');
const accepted = risks.filter((r) => r.treatment !== 'mitigate');
const byAsset = assets
  .map((a) => ({ ...a, risks: risks.filter((r) => r.asset === a.id) }))
  .sort((a, b) => b.risks.length - a.risks.length);
const searchText = (r: Risk) =>
  plain([r.title, r.text ?? '', assetTitle(r.asset), ...r.cia.map((c) => CIA_LABEL[c]), ...r.scenarios.map((s) => s.title), ...r.refs].join(' ')).toLowerCase();
const share = (n: number) => `${(n / risks.length) * 100}%`;
---
<Base title="AI Risk Map" description={`${risks.length} risks to AI systems across ${assets.length} kinds of asset, rated before and after controls.`}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">AI Controls · Risk Map</span>
      <h1>What could go wrong, and what controls change</h1>
      <p class="lead">
        {risks.length} things that can go wrong when AI agents run in production, each rated for how likely it is and how much
        harm it would do: first without controls, then with them.
      </p>
      <dl class="stats">
        <div><dt>Risks</dt><dd>{risks.length}</dd></div>
        <div><dt>Kinds of asset at risk</dt><dd>{assets.length}</dd></div>
        <div><dt>Ways they can happen</dt><dd>{scenarioCount}</dd></div>
        <div class="headline"><dt>High risks, without → with controls</dt><dd>{highBefore} <span aria-hidden="true">→</span><span class="visually-hidden">to</span> {highAfter}</dd></div>
      </dl>
    </div>
  </section>

  <section class="soft matrix-section">
    <div class="container matrix-layout">
      <div>
        <div class="matrix-head">
          <h2>The risk matrix</h2>
          <div class="switch" role="group" aria-label="Rating">
            <button type="button" aria-pressed="true" data-when="inherent">Without controls</button>
            <button type="button" aria-pressed="false" data-when="residual">With controls</button>
          </div>
        </div>
        <p class="muted hint">Each square counts the risks with that likelihood and impact. Select one to list them below.</p>
        <div class="matrix" data-when="inherent">
          <span class="axis axis-y">Impact →</span>
          {[3, 2, 1].map((i) => (
            <>
              <span class="tick tick-y" style={`grid-row:${4 - i}`} title={scales.impact[i - 1].text}>{scales.impact[i - 1].short}</span>
              {[1, 2, 3].map((l) => (
                <button
                  type="button"
                  class={`cell lvl-${levelOf(l, i)}`}
                  style={`grid-row:${4 - i};grid-column:${l + 2}`}
                  data-l={l}
                  data-i={i}
                  data-inherent={inCell('inherent', l, i)}
                  data-residual={inCell('residual', l, i)}
                  aria-label={`Likelihood ${l}, impact ${i}`}
                >
                  <span class="n">{inCell('inherent', l, i) || '–'}</span>
                  <span class="cell-level">{LEVEL_LABEL[levelOf(l, i)]}</span>
                </button>
              ))}
            </>
          ))}
          {[1, 2, 3].map((l) => <span class="tick tick-x" style={`grid-column:${l + 2}`} title={scales.likelihood[l - 1].text}>{scales.likelihood[l - 1].short}</span>)}
          <span class="axis axis-x">Likelihood →</span>
        </div>
      </div>

      <div class="levels">
        <h3>Risk levels</h3>
        {(['inherent', 'residual'] as const).map((when) => (
          <div class="level-bar">
            <p class="lb-label">{when === 'inherent' ? 'Without controls' : 'With controls'}</p>
            <div class="stack" role="img" aria-label={LEVELS.map((l) => `${count(l, when)} ${l}`).join(', ')}>
              {LEVELS.filter((l) => count(l, when)).map((l) => (
                <span class={`seg seg-${l}`} style={`width:${share(count(l, when))}`} title={`${count(l, when)} ${l}`}></span>
              ))}
            </div>
            <p class="lb-counts">
              {LEVELS.map((l) => <span class={`lvl lvl-${l}`}>{count(l, when)} {l}</span>)}
            </p>
          </div>
        ))}
        <p class="muted levels-note">
          Level is likelihood × impact: low 1–2, medium 3–4, high 6–9. "With controls" assumes each control works as designed.
        </p>
      </div>
    </div>
  </section>

  <GraphBand
    eyebrow="Outside the wall"
    title="Every risk, held back by controls"
    text={`Each warning sign is a risk, linked to the asset it threatens and the controls that hold it back. Hover one to see its level and connections; click to open it.`}
    layers={['asset_class', 'control', 'risk']}
    focus={['risk']}
    focusLinks={['mitigated_by']}
  />

  <section class="watch">
    <div class="container">
      <h2>On the watch list</h2>
      <p class="muted intro">The risks that controls don't bring down far enough yet, and the one accepted for now.</p>
      <div class="watch-grid">
        {stillHigh.map((r) => (
          <a class="card watch-card" href={riskHref(r)}>
            <span class="lvl lvl-high">Still high with controls</span>
            <h3>{r.title}</h3>
            <p class="muted">{assetTitle(r.asset)} · {r.controls.length ? `${r.controls.length} ${r.controls.length === 1 ? 'control' : 'controls'} so far` : 'No control yet'}</p>
          </a>
        ))}
        {accepted.map((r) => (
          <a class="card watch-card" href={riskHref(r)}>
            <span class={`lvl lvl-${r.residual.level}`}>Accepted · {r.residual.level}</span>
            <h3>{r.title}</h3>
            <p class="muted">{r.decision?.reviewBy ? `To be reviewed by ${new Date(r.decision.reviewBy).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}` : assetTitle(r.asset)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="soft assets-section">
    <div class="container">
      <h2>Risks by asset</h2>
      <p class="muted intro">What each kind of asset faces, and where its risks land with controls.</p>
      <div class="asset-grid">
        {byAsset.map((a) => (
          <a class="asset" href={`#asset-${a.id}`}>
            <span class="a-top"><strong>{a.title}</strong><span class="a-n">{a.risks.length}</span></span>
            {a.family && <span class="a-family">{a.family}</span>}
            <span class="stack small" aria-hidden="true">
              {LEVELS.map((l) => {
                const n = a.risks.filter((r) => r.residual.level === l).length;
                return n ? <span class={`seg seg-${l}`} style={`flex-grow:${n}`}></span> : null;
              })}
            </span>
            <span class="a-counts">
              {LEVELS.map((l) => {
                const n = a.risks.filter((r) => r.residual.level === l).length;
                return n ? <span>{n} {l}</span> : null;
              })}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div id="all-risks" class="anchor"></div>
  <Lookup
    placeholder="Search risks, e.g. injection, secret or tenant"
    noun={['risk', 'risks']}
    filters={LEVELS.map((l) => ({ label: `${LEVEL_LABEL[l]} with controls`, tag: `residual-${l}` }))}
  />

  <section class="list-section">
    <div class="container">
      <p class="cell-note" id="cell-note" hidden></p>
      {byAsset.map((a) => (
        <div class="group" id={`asset-${a.id}`} data-group>
          <h2 class="group-head">{a.title} <span class="muted">{a.risks.length}</span></h2>
          <ul class="rows">
            {a.risks.map((r) => (
              <li
                data-entry
                data-search={searchText(r)}
                data-tags={`residual-${r.residual.level} inherent-${cell(r, 'inherent')} residual-${cell(r, 'residual')}`}
              >
                <a href={riskHref(r)} class="row">
                  <span class="row-title">{r.title}</span>
                  <span class="cia" title={r.cia.map((c) => CIA_LABEL[c]).join(', ') || 'No CIA rating'}>
                    {['C', 'I', 'A'].map((c) => <span class:list={['cia-l', { on: r.cia.includes(c) }]}>{c}</span>)}
                  </span>
                  <span class="change">
                    <span class={`lvl lvl-${r.inherent.level}`}>{LEVEL_LABEL[r.inherent.level]}</span>
                    <span class="arrow" aria-hidden="true">→</span><span class="visually-hidden">with controls</span>
                    <span class={`lvl lvl-${r.residual.level}`}>{LEVEL_LABEL[r.residual.level]}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div id="lookup-empty" class="empty" hidden>
        <p>No risk matches that search.</p>
        <button type="button" id="lookup-clear" class="btn btn-ghost">Clear search</button>
      </div>
      <p class="key muted">
        C, I and A show what each risk threatens: <strong>C</strong>onfidentiality, <strong>I</strong>ntegrity or <strong>A</strong>vailability.
      </p>
    </div>
  </section>

  <CtaBand heading="Want to know which of these risks apply to you?" text="A 30 minute call to map the risks that matter for your AI use, and the controls that bring them down." />
</Base>

<script>
  const matrix = document.querySelector<HTMLElement>('.matrix')!;
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('.switch button')];
  const cells = [...matrix.querySelectorAll<HTMLButtonElement>('.cell')];
  const note = document.getElementById('cell-note')!;

  // Swap the matrix between the ratings without and with controls.
  function show(when: string) {
    matrix.dataset.when = when;
    toggles.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.when === when)));
    for (const c of cells) {
      const n = Number(c.dataset[when as 'inherent' | 'residual']);
      c.querySelector('.n')!.textContent = n ? String(n) : '–';
      c.classList.toggle('zero', !n);
      c.setAttribute('aria-pressed', 'false');
    }
  }
  toggles.forEach((t) => t.addEventListener('click', () => show(t.dataset.when!)));

  // Selecting a square filters the list below to the risks in it.
  cells.forEach((c) =>
    c.addEventListener('click', () => {
      if (c.classList.contains('zero')) return;
      const when = matrix.dataset.when!;
      const on = c.getAttribute('aria-pressed') !== 'true';
      cells.forEach((x) => x.setAttribute('aria-pressed', String(on && x === c)));
      document.dispatchEvent(new CustomEvent('lookup:filter', { detail: on ? `${when}-${c.dataset.l}-${c.dataset.i}` : '' }));
      note.hidden = !on;
      note.textContent = on
        ? `Showing the risks rated likelihood ${c.dataset.l}, impact ${c.dataset.i} ${when === 'inherent' ? 'without' : 'with'} controls.`
        : '';
      if (on) document.getElementById('all-risks')!.scrollIntoView({ behavior: 'smooth' });
    }),
  );
  // Any search-bar filter replaces the square's.
  document.querySelectorAll('.lookup [data-filter]').forEach((chip) =>
    chip.addEventListener('click', () => {
      cells.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      note.hidden = true;
    }),
  );
  show('inherent');
</script>

<style>
  .hero { padding-bottom: 2.5rem; }
  .stats { display: flex; flex-wrap: wrap; gap: 0.8rem 2.5rem; margin: 2rem 0 0; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; color: var(--accent-strong); }
  :root[data-theme='dark'] .stats dd { color: var(--accent); }
  .stats dt { font-size: 0.85rem; color: var(--muted); }
  .stats .headline dd { color: var(--text); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .matrix-layout { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2.5rem 4rem; align-items: start; }
  .matrix-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.8rem; }
  .matrix-head h2 { margin: 0; }
  .hint { font-size: 0.92rem; margin: 0.6rem 0 1.2rem; }
  .switch { display: inline-flex; padding: 0.25rem; border-radius: 999px; background: var(--bg); border: 1px solid var(--border); }
  .switch button {
    font: inherit; font-size: 0.88rem; font-weight: 600; cursor: pointer; border: 0; border-radius: 999px;
    padding: 0.4rem 0.9rem; background: none; color: var(--muted); transition: background 0.2s, color 0.2s;
  }
  .switch button[aria-pressed='true'] { background: var(--accent); color: var(--accent-contrast); }

  .matrix {
    display: grid; gap: 6px; align-items: stretch;
    grid-template-columns: 1.4rem minmax(6rem, auto) repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(3, 5.5rem) auto auto;
  }
  .axis { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .axis-y { grid-row: 1 / 4; grid-column: 1; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; align-self: center; }
  .axis-x { grid-row: 5; grid-column: 3 / -1; text-align: center; margin-top: 0.1rem; }
  .tick { font-size: 0.78rem; color: var(--muted); line-height: 1.25; }
  .tick-y { grid-column: 2; align-self: center; text-align: right; padding-right: 0.3rem; }
  .tick-x { grid-row: 4; text-align: center; padding-top: 0.2rem; }
  .cell {
    min-width: 0; display: grid; place-content: center; gap: 0.1rem; text-align: center; cursor: pointer;
    font: inherit; color: var(--text); border-radius: 12px;
    background: color-mix(in srgb, var(--lvl) 16%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--lvl) 40%, transparent);
    transition: transform 0.15s, box-shadow 0.15s, background 0.3s;
  }
  .cell:hover:not(.zero) { transform: translateY(-2px); box-shadow: 0 6px 16px rgb(0 0 0 / 0.08); }
  .cell[aria-pressed='true'] { box-shadow: 0 0 0 3px var(--lvl); }
  .cell.zero { cursor: default; background: color-mix(in srgb, var(--lvl) 6%, var(--bg)); }
  .cell .n { font-size: clamp(1.4rem, 3vw, 2.1rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; transition: opacity 0.2s; }
  .cell.zero .n { color: var(--muted); font-weight: 500; }
  .cell-level { font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }

  .levels h3 { font-size: 1.05rem; margin-bottom: 1.2rem; }
  .level-bar + .level-bar { margin-top: 1.4rem; }
  .lb-label { font-weight: 600; font-size: 0.92rem; margin: 0 0 0.4rem; }
  .stack { display: flex; gap: 2px; height: 14px; border-radius: 4px; overflow: hidden; }
  .stack.small { height: 6px; margin: 0.7rem 0 0.4rem; }
  .seg { display: block; min-width: 4px; }
  .seg-high { background: var(--risk-high); }
  .seg-medium { background: var(--risk-medium); }
  .seg-low { background: var(--risk-low); }
  .lb-counts { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.5rem 0 0; }
  .levels-note { font-size: 0.85rem; margin-top: 1.4rem; }

  .intro { margin-bottom: 1.4rem; }
  .watch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .watch-card { display: grid; gap: 0.5rem; align-content: start; }
  .watch-card .lvl { justify-self: start; }
  .watch-card h3 { font-size: 1.05rem; margin: 0; }
  .watch-card p { margin: 0; font-size: 0.88rem; }

  .asset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.8rem; }
  .asset {
    display: grid; align-content: start; padding: 0.9rem 1rem; border-radius: 12px; text-decoration: none;
    background: var(--bg); border: 1px solid var(--border); color: var(--text) !important; transition: border-color 0.15s, transform 0.15s;
  }
  .asset:hover { border-color: var(--accent); transform: translateY(-2px); }
  .a-top { display: flex; justify-content: space-between; gap: 0.5rem; align-items: baseline; }
  .a-n { font-weight: 800; font-size: 1.2rem; }
  .a-family { font-size: 0.78rem; color: var(--muted); }
  .a-counts { display: flex; gap: 0.6rem; font-size: 0.75rem; color: var(--muted); }

  .anchor { scroll-margin-top: 4rem; }
  .list-section { padding-top: 1.2rem; }
  .cell-note { margin: 0.5rem 0 0; font-weight: 600; }
  .group { scroll-margin-top: 10rem; }
  .group-head { font-size: 1.3rem; border-bottom: 1px solid var(--border); padding: 1.6rem 0 0.6rem; margin: 0; }
  .group-head .muted { font-weight: 500; }
  .rows { list-style: none; padding: 0; margin: 0; }
  .rows li { border-bottom: 1px solid var(--border); }
  .row { display: grid; grid-template-columns: 1fr auto 13rem; gap: 0.4rem 1.2rem; align-items: center; padding: 0.75rem 0.4rem; text-decoration: none; color: var(--text) !important; border-radius: 8px; }
  .row:hover { background: var(--bg-soft); }
  .row:hover .row-title { color: var(--accent-strong); }
  :root[data-theme='dark'] .row:hover .row-title { color: var(--accent); }
  .cia { display: flex; gap: 2px; }
  .cia-l { width: 1.3rem; height: 1.3rem; display: grid; place-items: center; border-radius: 4px; font: 700 0.68rem ui-monospace, Menlo, monospace; color: var(--border); border: 1px solid var(--border); }
  .cia-l.on { color: var(--text); border-color: var(--muted); }
  .change { display: flex; align-items: center; gap: 0.4rem; justify-content: flex-end; }
  .change .arrow { color: var(--muted); }
  .empty { text-align: center; padding: 3rem 0; color: var(--muted); }
  .key { margin-top: 2rem; font-size: 0.88rem; }

  @media (max-width: 900px) {
    .matrix-layout { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .matrix { grid-template-columns: 1.2rem 4.5rem repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(3, 4.2rem) auto auto; }
    .tick { font-size: 0.68rem; }
    .cell-level { display: none; }
    .row { grid-template-columns: 1fr auto; }
    .row-title { grid-column: 1 / -1; }
    .change { justify-content: flex-start; }
  }
</style>
