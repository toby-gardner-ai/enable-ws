---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import areas from '../data/readiness.json';

// Generated by `npm run extract:readiness` from the AI readiness questions.
const questions = areas.flatMap((a) => a.questions);
const practiceCount = questions.reduce((n, q) => n + q.practices.length, 0);
const minutes = Math.round((questions.length * 15) / 60 / 5) * 5;
let n = 0;
---
<Base title="AI Readiness Checklist" description={`${questions.length} questions to find out how ready you are to run AI in production, with a readiness score and a list of what to fix first.`}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">AI Enablement · Readiness Checklist</span>
      <h1>How ready are you to run AI in production?</h1>
      <p class="lead">
        Tick the practices you already have in place. You get a readiness score, a breakdown by area and a
        short list of what to work on next. Your answers stay in this browser.
      </p>
      <dl class="stats">
        <div><dt>Questions</dt><dd>{questions.length}</dd></div>
        <div><dt>Areas</dt><dd>{areas.length}</dd></div>
        <div><dt>Practices</dt><dd>{practiceCount}</dd></div>
        <div><dt>Minutes, about</dt><dd>{minutes}</dd></div>
      </dl>
      <div class="btn-row">
        <a href={`#area-${areas[0].id}`} class="btn btn-primary">Start the checklist →</a>
        <a href="#results" class="btn btn-ghost">Jump to results</a>
      </div>
    </div>
  </section>

  <section class="how soft">
    <div class="container grid grid-3">
      <div><span class="step-num">1</span><h3>Tick what you already do</h3><p class="muted">Each question lists good practices. Tick the ones in place, or "None of these yet". Tap "Why?" to see why each one matters.</p></div>
      <div><span class="step-num">2</span><h3>Watch your score build</h3><p class="muted">Your score updates as you go. Answer the areas that apply to you; you don't have to do all {questions.length}.</p></div>
      <div><span class="step-num">3</span><h3>Get your next steps</h3><p class="muted">Your results show your weakest areas and the practices to put in place first, ready to copy and share with your team.</p></div>
    </div>
  </section>

  <section class="checklist">
    <div class="container layout">
      <aside class="panel" aria-label="Your progress">
        <div class="dial">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="52" class="track" />
            <circle cx="60" cy="60" r="52" class="fill" id="dial-fill" />
          </svg>
          <div class="dial-text">
            <strong data-score>–</strong>
            <span>readiness</span>
          </div>
        </div>
        <p class="level" data-level>Answer a question to start</p>
        <p class="answered-count"><span data-answered>0</span> of {questions.length} answered</p>
        <ul class="area-nav">
          {areas.map((a) => (
            <li>
              <a href={`#area-${a.id}`}>
                <span class="ln-name">{a.name}</span>
                <span class="ln-count"><span data-area-answered={a.id}>0</span>/{a.questions.length}</span>
                <span class="ln-bar"><span data-area-bar={a.id}></span></span>
              </a>
            </li>
          ))}
        </ul>
        <label class="switch">
          <input type="checkbox" id="hide-answered" />
          <span>Hide answered questions</span>
        </label>
        <a href="#results" class="btn btn-primary panel-btn">See my results</a>
      </aside>

      <div class="questions">
        {areas.map((area, ai) => (
          <section class="area" id={`area-${area.id}`}>
            <header class="area-head">
              <span class="eyebrow">Area {ai + 1} of {areas.length}</span>
              <h2>{area.name}</h2>
              <p class="muted">{area.questions.length} {area.questions.length === 1 ? 'question' : 'questions'}</p>
            </header>
            {area.questions.map((q) => {
              n++;
              return (
                <article class="q card" id={q.id} data-q data-area={area.id} data-area-name={area.name} data-lens={q.lens}>
                  <div class="q-top">
                    <span class="q-num">Q{n}</span>
                    <span class="tag">{q.lens}</span>
                    <span class="q-state" data-q-state>Not answered</span>
                  </div>
                  <h3>{q.title}</h3>
                  <p class="q-desc">{q.description}</p>
                  <fieldset>
                    <legend class="visually-hidden">Practices you have in place</legend>
                    {q.practices.map((p, pi) => (
                      <div class="opt">
                        <label>
                          <input type="checkbox" data-practice={pi} />
                          <span class="box" aria-hidden="true"></span>
                          <span class="opt-title">{p.title}</span>
                        </label>
                        {p.why && (
                          <>
                            <button type="button" class="why-btn" aria-expanded="false" aria-controls={`${q.id}-why-${pi}`}>Why?</button>
                            <p class="why" id={`${q.id}-why-${pi}`} hidden>{p.why}</p>
                          </>
                        )}
                      </div>
                    ))}
                    {q.hasNone && (
                      <label class="none">
                        <input type="checkbox" data-none />
                        <span>None of these yet</span>
                      </label>
                    )}
                  </fieldset>
                </article>
              );
            })}
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="results" class="results soft">
    <div class="container">
      <span class="eyebrow">Your results</span>
      <h2>Where you stand</h2>
      <div class="empty card" data-empty>
        <p>Answer a few questions and your results appear here: your score, your strongest and weakest areas, and what to work on first.</p>
        <a href={`#area-${areas[0].id}`} class="btn btn-primary">Start the checklist →</a>
      </div>
      <div class="result-body" data-results hidden>
        <div class="result-grid">
          <div class="card score-card">
            <p class="big-score"><span data-score>–</span></p>
            <p class="score-level" data-level></p>
            <p class="muted" data-level-text></p>
            <p class="based">Based on <span data-answered>0</span> of {questions.length} questions answered.</p>
          </div>
          <div class="card">
            <h3>By area</h3>
            <div class="bars" id="area-bars"></div>
          </div>
          <div class="card">
            <h3>By lens</h3>
            <div class="bars" id="lens-bars"></div>
          </div>
        </div>

        <div class="next-steps">
          <h3>Where to start</h3>
          <p class="muted">Practices you don't have yet, from the questions where you scored lowest.</p>
          <ol class="gaps" id="gaps"></ol>
          <p class="all-done" id="no-gaps" hidden>No gaps in the questions you've answered. Answer more to keep going.</p>
        </div>

        <div class="btn-row">
          <button type="button" class="btn btn-primary" id="copy">Copy summary</button>
          <button type="button" class="btn btn-ghost" id="reset">Start again</button>
        </div>
      </div>
    </div>
  </section>

  <div class="mobile-bar">
    <span><strong data-score>–</strong> readiness</span>
    <span><span data-answered>0</span>/{questions.length} answered</span>
    <a href="#results">Results →</a>
  </div>

  <CtaBand
    heading="Want help closing the gaps?"
    text="Bring your results to a 30 minute call. We'll pick the gaps that matter most for your business and plan the first step."
  />
</Base>

<script>
  type Answer = { p: number[]; none: boolean };
  const KEY = 'readiness:v1';
  const LEVELS = [
    { min: 75, name: 'Leading', text: 'Nearly everything is in place. Keep reviewing as your AI use, and the rules around it, change.' },
    { min: 50, name: 'Scaling with confidence', text: 'Most practices are in place. Close the remaining gaps and keep the rest working as you grow.' },
    { min: 25, name: 'Building foundations', text: 'Some key practices are in place. Close the gaps below before you scale AI to more teams or customers.' },
    { min: 0, name: 'Getting started', text: "Few of these practices are in place yet. That's normal early on: start with the gaps below that carry the most risk." },
  ];

  const cards = [...document.querySelectorAll<HTMLElement>('[data-q]')];
  const total = cards.length;
  let answers: Record<string, Answer> = {};
  try {
    answers = JSON.parse(localStorage.getItem(KEY) ?? '{}');
  } catch {}

  const practiceBoxes = (card: HTMLElement) => [...card.querySelectorAll<HTMLInputElement>('[data-practice]')];
  const noneBox = (card: HTMLElement) => card.querySelector<HTMLInputElement>('[data-none]');
  const pct = (x: number) => `${Math.round(x * 100)}%`;
  const setAll = (selector: string, text: string) =>
    document.querySelectorAll(selector).forEach((el) => (el.textContent = text));

  // Restore saved answers.
  for (const card of cards) {
    const a = answers[card.id];
    if (!a) continue;
    practiceBoxes(card).forEach((b, i) => (b.checked = a.p.includes(i)));
    const none = noneBox(card);
    if (none) none.checked = a.none;
  }

  function read(card: HTMLElement) {
    const boxes = practiceBoxes(card);
    const ticked = boxes.filter((b) => b.checked).length;
    const none = !!noneBox(card)?.checked;
    return { answered: ticked > 0 || none, ticked, of: boxes.length, score: boxes.length ? ticked / boxes.length : 0 };
  }

  function save() {
    answers = {};
    for (const card of cards) {
      const p = practiceBoxes(card).flatMap((b, i) => (b.checked ? [i] : []));
      const none = !!noneBox(card)?.checked;
      if (p.length || none) answers[card.id] = { p, none };
    }
    try {
      localStorage.setItem(KEY, JSON.stringify(answers));
    } catch {}
  }

  function bar(label: string, value: number | null, detail: string) {
    const row = document.createElement('div');
    row.className = 'bar-row';
    row.title = detail;
    const name = document.createElement('span');
    name.className = 'bar-label';
    name.textContent = label;
    const track = document.createElement('span');
    track.className = 'bar-track';
    const fill = document.createElement('span');
    fill.className = 'bar-fill';
    fill.style.width = value === null ? '0' : pct(value);
    track.append(fill);
    const val = document.createElement('span');
    val.className = 'bar-value';
    val.textContent = value === null ? '–' : pct(value);
    row.append(name, track, val);
    return row;
  }

  // Average score of the answered questions in each group.
  function groupScores(key: (card: HTMLElement) => string) {
    const groups = new Map<string, { sum: number; answered: number; total: number }>();
    for (const card of cards) {
      const g = groups.get(key(card)) ?? { sum: 0, answered: 0, total: 0 };
      const r = read(card);
      g.total++;
      if (r.answered) {
        g.answered++;
        g.sum += r.score;
      }
      groups.set(key(card), g);
    }
    return groups;
  }

  const hideAnswered = document.getElementById('hide-answered') as HTMLInputElement;

  function render() {
    let answered = 0;
    let sum = 0;
    for (const card of cards) {
      const r = read(card);
      card.classList.toggle('answered', r.answered);
      card.querySelector('[data-q-state]')!.textContent = r.answered ? `${r.ticked} of ${r.of} in place` : 'Not answered';
      card.hidden = hideAnswered.checked && r.answered && !card.contains(document.activeElement);
      if (r.answered) {
        answered++;
        sum += r.score;
      }
    }
    const score = answered ? sum / answered : null;
    const level = score === null ? null : LEVELS.find((l) => score * 100 >= l.min)!;

    setAll('[data-score]', score === null ? '–' : pct(score));
    setAll('[data-answered]', String(answered));
    setAll('[data-level]', level?.name ?? 'Answer a question to start');
    setAll('[data-level-text]', level?.text ?? '');
    const circumference = 2 * Math.PI * 52;
    const dial = document.getElementById('dial-fill')!;
    dial.style.strokeDasharray = String(circumference);
    dial.style.strokeDashoffset = String(circumference * (1 - (score ?? 0)));

    // Sidebar: how much of each area is answered.
    const byArea = groupScores((c) => c.dataset.area!);
    for (const [id, g] of byArea) {
      setAll(`[data-area-answered="${id}"]`, String(g.answered));
      const fill = document.querySelector<HTMLElement>(`[data-area-bar="${id}"]`);
      if (fill) fill.style.width = pct(g.answered / g.total);
    }

    // Results.
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = answered > 0;
    document.querySelector<HTMLElement>('[data-results]')!.hidden = answered === 0;
    document.getElementById('area-bars')!.replaceChildren(
      ...[...groupScores((c) => c.dataset.areaName!)].map(([name, g]) =>
        bar(name, g.answered ? g.sum / g.answered : null, `${g.answered} of ${g.total} questions answered`),
      ),
    );
    const byLens = [...groupScores((c) => c.dataset.lens!)].sort(
      ([, a], [, b]) => (b.answered ? b.sum / b.answered : -1) - (a.answered ? a.sum / a.answered : -1),
    );
    document.getElementById('lens-bars')!.replaceChildren(
      ...byLens.map(([name, g]) =>
        bar(name, g.answered ? g.sum / g.answered : null, `${g.answered} of ${g.total} questions answered`),
      ),
    );

    // Where to start: missing practices from the lowest-scoring answered questions,
    // at most two per question so the list covers more ground.
    const gaps = cards
      .map((card) => ({ card, r: read(card) }))
      .filter(({ r }) => r.answered && r.score < 1)
      .sort((a, b) => a.r.score - b.r.score)
      .flatMap(({ card }) =>
        practiceBoxes(card)
          .filter((b) => !b.checked)
          .slice(0, 2)
          .map((b) => ({ card, opt: b.closest('.opt')! })),
      )
      .slice(0, 8);
    document.getElementById('gaps')!.replaceChildren(
      ...gaps.map(({ card, opt }) => {
        const li = document.createElement('li');
        const title = document.createElement('strong');
        title.textContent = opt.querySelector('.opt-title')!.textContent;
        const why = document.createElement('p');
        why.textContent = opt.querySelector('.why')?.textContent ?? '';
        const from = document.createElement('a');
        from.href = `#${card.id}`;
        from.textContent = `${card.querySelector('.q-num')!.textContent}: ${card.querySelector('h3')!.textContent}`;
        li.append(title, why, from);
        return li;
      }),
    );
    document.getElementById('no-gaps')!.hidden = gaps.length > 0;
  }

  document.querySelector('.questions')!.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const card = input.closest<HTMLElement>('[data-q]');
    if (!card) return;
    // "None of these yet" and the practices exclude each other.
    if (input.matches('[data-none]') && input.checked) practiceBoxes(card).forEach((b) => (b.checked = false));
    if (input.matches('[data-practice]') && input.checked) {
      const none = noneBox(card);
      if (none) none.checked = false;
    }
    save();
    render();
  });

  document.querySelectorAll<HTMLButtonElement>('.why-btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.textContent = open ? 'Why?' : 'Hide';
      document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = open;
    }),
  );

  hideAnswered.addEventListener('change', render);

  document.getElementById('reset')!.addEventListener('click', () => {
    if (!confirm('Clear all your answers and start again?')) return;
    cards.forEach((card) => {
      practiceBoxes(card).forEach((b) => (b.checked = false));
      const none = noneBox(card);
      if (none) none.checked = false;
    });
    save();
    render();
    document.querySelector('.area')?.scrollIntoView();
  });

  document.getElementById('copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const lines = [
      `AI readiness: ${document.querySelector('[data-score]')!.textContent} (${document.querySelector('[data-level]')!.textContent})`,
      `${document.querySelector('[data-answered]')!.textContent} of ${total} questions answered`,
      '',
      'By area:',
      ...[...document.querySelectorAll('#area-bars .bar-row')].map(
        (r) => `- ${r.querySelector('.bar-label')!.textContent}: ${r.querySelector('.bar-value')!.textContent}`,
      ),
      '',
      'By lens:',
      ...[...document.querySelectorAll('#lens-bars .bar-row')].map(
        (r) => `- ${r.querySelector('.bar-label')!.textContent}: ${r.querySelector('.bar-value')!.textContent}`,
      ),
      '',
      'Where to start:',
      ...[...document.querySelectorAll('#gaps strong')].map((s, i) => `${i + 1}. ${s.textContent}`),
      '',
      location.href.split('#')[0],
    ];
    try {
      await navigator.clipboard.writeText(lines.join('\n'));
      btn.textContent = 'Copied ✓';
    } catch {
      btn.textContent = 'Copy failed';
    }
    setTimeout(() => (btn.textContent = 'Copy summary'), 2000);
  });

  render();
</script>

<style>
  .hero { padding-bottom: 3rem; }
  .stats { display: flex; flex-wrap: wrap; gap: 0.8rem 2.5rem; margin: 2rem 0 0; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; color: var(--accent-strong); }
  :root[data-theme='dark'] .stats dd { color: var(--accent); }
  .stats dt { font-size: 0.85rem; color: var(--muted); }
  .how { padding: 2.5rem 0; }
  .how h3 { margin-bottom: 0.3rem; }
  .how p { margin: 0; font-size: 0.95rem; }

  .checklist { padding-top: 3rem; }
  .layout { display: grid; grid-template-columns: 17rem 1fr; gap: 2.5rem; align-items: start; }

  /* Progress panel */
  .panel {
    position: sticky; top: 5rem; display: grid; gap: 0.9rem;
    padding: 1.4rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg);
  }
  .dial { position: relative; width: 8.5rem; margin: 0 auto; }
  .dial svg { display: block; transform: rotate(-90deg); }
  .dial circle { fill: none; stroke-width: 9; }
  .track { stroke: var(--bg-soft); }
  .fill { stroke: var(--accent); stroke-linecap: round; transition: stroke-dashoffset 0.4s ease; }
  .dial-text { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .dial-text strong { font-size: 1.9rem; letter-spacing: -0.03em; line-height: 1; }
  .dial-text span { font-size: 0.75rem; color: var(--muted); }
  .level { text-align: center; font-weight: 700; margin: 0; }
  .answered-count { text-align: center; font-size: 0.88rem; color: var(--muted); margin: -0.6rem 0 0; }
  .area-nav { list-style: none; padding: 0.9rem 0 0; margin: 0; border-top: 1px solid var(--border); display: grid; gap: 0.2rem; }
  .area-nav a {
    display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 0.5rem;
    padding: 0.4rem 0.5rem; border-radius: 8px; text-decoration: none; color: var(--text) !important; font-size: 0.9rem;
  }
  .area-nav a:hover { background: var(--bg-soft); }
  .ln-count { font-size: 0.8rem; color: var(--muted); }
  .ln-bar { grid-column: 1 / -1; height: 4px; border-radius: 4px; background: var(--bg-soft); overflow: hidden; }
  .ln-bar span { display: block; height: 100%; width: 0; background: var(--accent); border-radius: 4px; transition: width 0.3s; }
  .switch { display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; color: var(--muted); cursor: pointer; }
  .switch input { accent-color: var(--accent); width: 1rem; height: 1rem; }
  .panel-btn { justify-content: center; }

  /* Questions */
  .area { scroll-margin-top: 5rem; }
  .area + .area { margin-top: 3.5rem; }
  .area-head { margin-bottom: 1.2rem; }
  .area-head .eyebrow { margin-bottom: 0.3rem; }
  .area-head h2 { margin-bottom: 0.2rem; }
  .area-head p { margin: 0; font-size: 0.92rem; }
  .q { margin-bottom: 1rem; scroll-margin-top: 5rem; transition: border-color 0.2s; }
  .q.answered { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .q-top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; }
  .q-top .tag { margin: 0; }
  .q-num { font-weight: 800; color: var(--accent-strong); font-size: 0.9rem; }
  :root[data-theme='dark'] .q-num { color: var(--accent); }
  .q-state { margin-left: auto; font-size: 0.8rem; color: var(--muted); }
  .q.answered .q-state { color: var(--accent-strong); font-weight: 600; }
  .q.answered .q-state::before { content: '✓ '; }
  :root[data-theme='dark'] .q.answered .q-state { color: var(--accent); }
  .q h3 { font-size: 1.2rem; }
  .q-desc { color: var(--muted); font-size: 0.95rem; }
  fieldset { border: 0; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.5rem; }

  .opt {
    display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 0 0.8rem;
    border: 1px solid var(--border); border-radius: 10px; padding: 0.7rem 0.9rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .opt:has(input:checked) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 7%, var(--bg)); }
  .opt label { display: flex; gap: 0.7rem; align-items: flex-start; cursor: pointer; font-size: 0.97rem; line-height: 1.45; }
  .opt input, .none input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .box {
    flex: none; width: 1.2rem; height: 1.2rem; margin-top: 0.1rem; border-radius: 5px;
    border: 2px solid var(--border); display: grid; place-items: center; transition: all 0.15s;
  }
  .opt input:checked + .box { background: var(--accent); border-color: var(--accent); }
  .opt input:checked + .box::after { content: '✓'; color: var(--accent-contrast); font-size: 0.75rem; font-weight: 800; }
  .opt input:focus-visible + .box { outline: 2px solid var(--accent); outline-offset: 2px; }
  .why-btn {
    background: none; border: 0; padding: 0.1rem 0; font: inherit; font-size: 0.82rem; font-weight: 600;
    color: var(--accent-strong); cursor: pointer; white-space: nowrap;
  }
  :root[data-theme='dark'] .why-btn { color: var(--accent); }
  .why {
    grid-column: 1 / -1; margin: 0.6rem 0 0 1.9rem; padding-left: 0.8rem;
    border-left: 2px solid var(--accent); font-size: 0.9rem; color: var(--muted);
  }
  .none {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.35rem 0.9rem; border: 1px dashed var(--border); border-radius: 999px;
    font-size: 0.88rem; color: var(--muted); cursor: pointer;
  }
  .none:has(input:checked) { border-style: solid; border-color: var(--text); color: var(--text); }
  .none:has(input:checked)::before { content: '✓'; font-weight: 700; }
  .none:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Results */
  .results { scroll-margin-top: 4rem; }
  .empty { max-width: 40rem; }
  .result-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 1rem; }
  .score-card { text-align: center; }
