---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import {
  ENFORCEMENT_LABEL,
  KIND_ICON,
  KIND_LABEL,
  KIND_PLURAL,
  PHASES,
  STANDING,
  controlHref,
  controls,
  controlsAt,
  enforcement,
  gates,
  kinds,
  standing,
} from '../../lib/controls';
import { inline } from '../../lib/inline';

// Generated by `npm run extract:controls` from the Control Register and the Standard.
const LEVELS = ['blocking', 'reporting', 'attested'] as const;
const stops = [...PHASES.flatMap((p) => p.gates.map((id) => gates.find((g) => g.id === id)!)), STANDING];

// Each stop's controls, blocking first, with the enforcement they have there.
const atStop = (id: string) =>
  controlsAt(id)
    .map((c) => ({ c, level: c.gates.find((g) => g.gate === id)!.enforcement }))
    .sort((a, b) => LEVELS.indexOf(a.level as any) - LEVELS.indexOf(b.level as any));
const tally = (id: string) => Object.fromEntries(LEVELS.map((l) => [l, atStop(id).filter((x) => x.level === l).length]));
const kindCount = (k: string) => controls.filter((c) => c.kind === k).length;
const phaseOf = (id: string) => PHASES.find((p) => p.gates.includes(id))?.name ?? 'Outside the lifecycle';
const busiest = stops.reduce((a, b) => (atStop(b.id).length > atStop(a.id).length ? b : a));
---
<Base title="AI Control Lifecycle" description={`${controls.length} AI governance controls and the moments in an agent's life where each one acts: from the first commit to retirement.`}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">AI Controls · Control Lifecycle</span>
      <h1>Every AI control, and the moment it acts</h1>
      <p class="lead">
        {controls.length} controls keep AI agents safe from the first commit to the day they're retired. Pick a moment in
        an agent's life to see which controls act there, and what happens when one fails.
      </p>
      <dl class="stats">
        <div><dt>Controls</dt><dd>{controls.length}</dd></div>
        {Object.keys(kinds).map((k) => <div><dt>{KIND_PLURAL[k]}</dt><dd>{kindCount(k)}</dd></div>)}
        <div><dt>Moments they act at</dt><dd>{gates.length}</dd></div>
      </dl>
    </div>
  </section>

  <section class="map-section soft">
    <div class="container">
      <div class="map-head">
        <h2>The life of an agent</h2>
        <ul class="legend" aria-label="Enforcement">
          {LEVELS.map((l) => <li><span class={`enf enf-${l}`}>{ENFORCEMENT_LABEL[l]}</span></li>)}
        </ul>
      </div>
      <div class="map" role="tablist" aria-label="Moments in an agent's life">
        {PHASES.map((phase, pi) => (
          <div class="phase">
            <p class="phase-name"><span>{pi + 1}</span>{phase.name}</p>
            <div class="gates">
              {phase.gates.map((id) => {
                const gate = gates.find((g) => g.id === id)!;
                const t = tally(id);
                return (
                  <button type="button" role="tab" class="gate" id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={id === busiest.id ? 'true' : 'false'} tabindex={id === busiest.id ? 0 : -1} data-gate={id}>
                    <span class="g-name">{gate.name}</span>
                    <span class="g-count">{atStop(id).length}<small> controls</small></span>
                    <span class="g-bar" aria-hidden="true">
                      {LEVELS.filter((l) => t[l]).map((l) => <span class={`seg seg-${l}`} style={`flex-grow:${t[l]}`} title={`${t[l]} ${l}`}></span>)}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        ))}
        <button type="button" role="tab" class="gate standing" id="tab-standing" aria-controls="panel-standing" aria-selected="false" tabindex="-1" data-gate="standing">
          <span class="g-name">Always on <small>· standing controls that hold at every moment</small></span>
          <span class="g-count">{atStop('standing').length}<small> controls</small></span>
        </button>
      </div>

      {stops.map((stop) => {
        const items = atStop(stop.id);
        const t = tally(stop.id);
        return (
          <div class="panel" role="tabpanel" id={`panel-${stop.id}`} aria-labelledby={`tab-${stop.id}`} hidden={stop.id !== busiest.id}>
            <div class="panel-head">
              <span class="eyebrow">{phaseOf(stop.id)}</span>
              <h3>{stop.name}</h3>
              {stop.id === 'standing' ? (
                <p class="facts-one">{standing.charAt(0).toUpperCase() + standing.slice(1)}</p>
              ) : (
                <dl class="facts">
                  <div><dt>When</dt><dd set:html={inline(stop.moment)} /></div>
                  <div><dt>If a blocking control fails, it stops</dt><dd set:html={inline(stop.stops)} /></div>
                </dl>
              )}
              <p class="tally">
                {LEVELS.filter((l) => t[l]).map((l) => <span class={`enf enf-${l}`}>{t[l]} {l}</span>)}
              </p>
            </div>
            <div class="chips" role="group" aria-label="Filter by kind">
              <button type="button" class="chip" aria-pressed="true" data-kind="">All {items.length}</button>
              {Object.keys(kinds).filter((k) => items.some((x) => x.c.kind === k)).map((k) => (
                <button type="button" class="chip" aria-pressed="false" data-kind={k}>{KIND_PLURAL[k]} {items.filter((x) => x.c.kind === k).length}</button>
              ))}
            </div>
            <ul class="rows">
              {items.map(({ c, level }) => (
                <li data-kind={c.kind}>
                  <a href={controlHref(c)} class="row">
                    <span class="ctl-id">{c.id}</span>
                    <span class="row-title">{c.title}</span>
                    <span class="row-kind"><span aria-hidden="true">{KIND_ICON[c.kind]}</span> {KIND_LABEL[c.kind]}</span>
                    <span class={`enf enf-${level}`}>{ENFORCEMENT_LABEL[level]}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Three kinds of control</h2>
      <p class="muted intro">Every control is one of three kinds, depending on how it's made to hold.</p>
      <div class="grid grid-3">
        {Object.entries(kinds).map(([k, text]) => (
          <a class="card kind-card" href={`/controls/library#kind-${k}`}>
            <span class="kind-icon" aria-hidden="true">{KIND_ICON[k]}</span>
            <h3>{KIND_PLURAL[k]} <span class="muted">{kindCount(k)}</span></h3>
            <p class="muted" set:html={inline(text)} />
            <span class="more">Browse {KIND_PLURAL[k].toLowerCase()} →</span>
          </a>
        ))}
      </div>
      <h2 class="enf-heading">What happens when a control fails</h2>
      <div class="grid grid-3">
        {LEVELS.map((l) => (
          <div class="card enf-card" style={`--enf-color: var(--enf-${l})`}>
            <h3><span class={`enf enf-${l}`}>{ENFORCEMENT_LABEL[l]}</span></h3>
            <p class="muted">{enforcement[l]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="Want these controls working in your business?" text="A 30 minute call to find which controls matter most for your AI use, and how to put the first ones in place." />
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];

  function select(tab: HTMLButtonElement, focus = false) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (focus) tab.focus();
    history.replaceState(null, '', `#gate-${tab.dataset.gate}`);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    // Arrow keys move along the lifecycle.
    tab.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (!step) return;
      e.preventDefault();
      select(tabs[(i + step + tabs.length) % tabs.length], true);
    });
  });

  // Filter a panel's controls by kind.
  document.querySelectorAll<HTMLElement>('[role=tabpanel]').forEach((panel) => {
    const chips = [...panel.querySelectorAll<HTMLButtonElement>('[data-kind].chip')];
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        panel.querySelectorAll<HTMLElement>('li[data-kind]').forEach((li) => {
          li.hidden = !!chip.dataset.kind && li.dataset.kind !== chip.dataset.kind;
        });
      }),
    );
  });

  const fromHash = tabs.find((t) => location.hash === `#gate-${t.dataset.gate}`);
  if (fromHash) select(fromHash);
</script>

<style>
  .hero { padding-bottom: 2.5rem; }
  .stats { display: flex; flex-wrap: wrap; gap: 0.8rem 2.5rem; margin: 2rem 0 0; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; color: var(--accent-strong); }
  :root[data-theme='dark'] .stats dd { color: var(--accent); }
  .stats dt { font-size: 0.85rem; color: var(--muted); }

  .map-section { padding-top: 3rem; }
  .map-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 2rem; margin-bottom: 1.2rem; }
  .map-head h2 { margin: 0; }
  .legend { display: flex; gap: 1.2rem; list-style: none; margin: 0; padding: 0; }

  .map { display: grid; grid-template-columns: 1fr 4fr 4fr 2fr; gap: 0.9rem; }
  .phase { display: grid; grid-template-rows: auto 1fr; gap: 0.5rem; min-width: 0; }
  .phase-name { display: flex; align-items: center; gap: 0.45rem; margin: 0; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .phase-name span {
    display: inline-grid; place-items: center; width: 1.3rem; height: 1.3rem; border-radius: 50%;
    background: var(--text); color: var(--bg); font-size: 0.7rem; letter-spacing: 0;
  }
  .gates { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.5rem; position: relative; }
  .gate {
    display: grid; align-content: space-between; gap: 0.5rem; text-align: left; min-width: 0;
    font: inherit; color: var(--text); cursor: pointer;
    background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 0.8rem 0.8rem 0.7rem;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .gate:hover { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); transform: translateY(-2px); }
  .gate[aria-selected='true'] {
    border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .g-name { font-weight: 700; font-size: 0.92rem; line-height: 1.25; }
  .g-name small { font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .g-count { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .g-count small { font-size: 0.72rem; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .g-bar { display: flex; gap: 2px; height: 6px; }
  .seg { min-width: 4px; border-radius: 4px; }
  .seg-blocking { background: var(--enf-blocking); }
  .seg-reporting { background: var(--enf-reporting); }
  .seg-attested { background: var(--enf-attested); }
  .standing {
    grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center;
    border-style: dashed; padding: 0.75rem 1rem;
  }
  .standing .g-count { font-size: 1.2rem; }

  .panel { margin-top: 1.5rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.6rem; }
  .panel-head h3 { font-size: 1.6rem; margin-bottom: 0.8rem; }
  .panel-head .eyebrow { margin-bottom: 0.3rem; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2rem; margin: 0 0 1rem; }
  .facts dt, .facts-one { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .facts dd { margin: 0.2rem 0 0; }
  .facts-one { text-transform: none; letter-spacing: 0; font-size: 1rem; font-weight: 400; color: var(--text); max-width: 60ch; }
  .facts :global(code), .kind-card :global(code) { font-size: 0.88em; background: var(--bg-soft); padding: 0.05rem 0.35rem; border-radius: 5px; }
  .tally { display: flex; flex-wrap: wrap; gap: 1.2rem; margin: 0 0 1.2rem; }
  .tally .enf { font-size: 0.88rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.8rem; }
  .chip {
    font: inherit; font-size: 0.85rem; cursor: pointer; padding: 0.35rem 0.85rem; border-radius: 999px;
    border: 1px solid var(--border); background: var(--bg); color: var(--muted);
  }
  .chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-contrast); }
  .rows { list-style: none; padding: 0; margin: 0; }
  .rows li + li { border-top: 1px solid var(--border); }
  .row {
    display: grid; grid-template-columns: 5rem 1fr 8.5rem 6rem; gap: 0.3rem 1rem; align-items: baseline;
    padding: 0.7rem 0.4rem; text-decoration: none; color: var(--text) !important; border-radius: 8px;
  }
  .row:hover { background: var(--bg-soft); }
  .row:hover .row-title { color: var(--accent-strong); }
  :root[data-theme='dark'] .row:hover .row-title { color: var(--accent); }
  .row .ctl-id { justify-self: start; }
  .row-title { font-size: 0.97rem; }
  .row-kind { font-size: 0.82rem; color: var(--muted); }

  .intro { margin-bottom: 1.5rem; }
  .kind-card { display: grid; gap: 0.3rem; align-content: start; }
  .kind-icon {
    display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 10px;
    background: var(--bg-soft); font-size: 1.2rem; margin-bottom: 0.4rem;
  }
  .kind-card h3 .muted { font-weight: 500; }
  .kind-card p { font-size: 0.95rem; }
  .more { font-weight: 600; font-size: 0.9rem; color: var(--accent-strong); margin-top: auto; }
  :root[data-theme='dark'] .more { color: var(--accent); }
  .enf-heading { margin-top: 3rem; }
  .enf-card { border-top: 4px solid var(--enf-color); }
  .enf-card .enf { font-size: 1.05rem; }
  .enf-card p { margin: 0; }

  @media (max-width: 900px) {
    .map { grid-template-columns: 1fr; }
    .gates { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); }
    .facts { grid-template-columns: 1fr; }
    .row { grid-template-columns: auto 1fr; }
    .row-title { grid-column: 1 / -1; grid-row: 2; }
    .row-kind { display: none; }
    .row .enf { justify-self: end; }
    .standing { flex-wrap: wrap; gap: 0.3rem; }
  }
</style>
