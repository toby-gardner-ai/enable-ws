---
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Lookup from '../../../components/Lookup.astro';
import { KIND_ICON, KIND_PLURAL, controlHref, controls, gateName, kinds, subjectsFor } from '../../../lib/controls';
import { plain } from '../../../lib/inline';

// Generated by `npm run extract:controls` from the Control Register.
const searchText = (c: (typeof controls)[number]) =>
  plain(
    [c.id, c.title, c.kind, ...c.gates.map((g) => `${gateName(g.gate)} ${g.enforcement}`), ...c.protects, ...subjectsFor(c).map((s) => s.subject)].join(' '),
  ).toLowerCase();
---
<Base title="AI Control Library" description={`All ${controls.length} AI governance controls: what each one checks, where it acts and what it protects.`}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">AI Controls · Control Library</span>
      <h1>Every control, in plain English</h1>
      <p class="lead">
        Search {controls.length} controls by what they do, where they act or what they protect. Open one to see the
        moments it acts at, what happens when it fails and the governance subjects it serves.
      </p>
      <p class="muted see-map">Prefer to explore by moment? <a href="/controls">See the control lifecycle →</a></p>
    </div>
  </section>

  <Lookup
    placeholder="Search controls, e.g. secrets, approval or prod"
    noun={['control', 'controls']}
    filters={Object.keys(kinds).map((k) => ({ label: KIND_PLURAL[k], tag: `kind-${k}` }))}
  />

  <section class="list-section">
    <div class="container">
      {Object.keys(kinds).map((k) => (
        <div class="group" id={`group-${k}`} data-group>
          <h2 class="group-head"><span class="kind-icon" aria-hidden="true">{KIND_ICON[k]}</span>{KIND_PLURAL[k]}</h2>
          <ul class="rows">
            {controls.filter((c) => c.kind === k).map((c) => (
              <li data-entry data-search={searchText(c)} data-tags={`kind-${c.kind}`}>
                <a href={controlHref(c)} class="row">
                  <span class="ctl-id">{c.id}</span>
                  <span class="row-title">{c.title}</span>
                  <span class="row-gates">
                    {c.gates.map((g) => <span class={`enf enf-${g.enforcement}`} title={g.enforcement}>{gateName(g.gate)}</span>)}
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div id="lookup-empty" class="empty" hidden>
        <p>No control matches that search.</p>
        <button type="button" id="lookup-clear" class="btn btn-ghost">Clear search</button>
      </div>
      <p class="key muted">
        The coloured dot shows how strictly a control acts at each moment:
        <span class="enf enf-blocking">Blocking</span>
        <span class="enf enf-reporting">Reporting</span>
        <span class="enf enf-attested">Attested</span>
      </p>
    </div>
  </section>

  <CtaBand heading="Want these controls working in your business?" text="A 30 minute call to find which controls matter most for your AI use, and how to put the first ones in place." />
</Base>

<style>
  .hero { padding-bottom: 2.5rem; }
  .see-map { margin: 0; }
  .list-section { padding-top: 1.2rem; }
  .group-head {
    display: flex; align-items: center; gap: 0.6rem; font-size: 1.4rem;
    border-bottom: 1px solid var(--border); padding: 1.6rem 0 0.6rem; margin: 0;
  }
  .kind-icon {
    display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 8px;
    background: var(--bg-soft); font-size: 1rem;
  }
  .rows { list-style: none; padding: 0; margin: 0; }
  .rows li { border-bottom: 1px solid var(--border); }
  .row {
    display: grid; grid-template-columns: 5rem 1fr minmax(10rem, 16rem) 1.2rem; gap: 0.4rem 1.2rem; align-items: baseline;
    padding: 0.85rem 0.4rem; text-decoration: none; color: var(--text) !important; border-radius: 8px;
  }
  .row:hover { background: var(--bg-soft); }
  .row:hover .row-title { color: var(--accent-strong); }
  :root[data-theme='dark'] .row:hover .row-title { color: var(--accent); }
  .row .ctl-id { justify-self: start; }
  .row-gates { display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; }
  .row-gates .enf { font-weight: 500; color: var(--muted); }
  .arrow { color: var(--muted); transition: transform 0.15s; }
  .row:hover .arrow { transform: translateX(3px); color: var(--accent-strong); }
  .empty { text-align: center; padding: 3rem 0; color: var(--muted); }
  .key { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; margin-top: 2rem; font-size: 0.88rem; }
  @media (max-width: 760px) {
    .row { grid-template-columns: auto 1fr; }
    .row-title { grid-column: 1 / -1; grid-row: 2; }
    .row-gates { grid-column: 1 / -1; grid-row: 3; }
    .arrow { display: none; }
  }
</style>
