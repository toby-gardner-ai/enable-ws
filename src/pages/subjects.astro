---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Lookup from '../components/Lookup.astro';
import subjects from '../data/subjects.json';
import { byFirstLetter, inline, plain, runs } from '../lib/inline';

// Generated by `npm run extract:governance` from the Governance Subject Register.
const groups = byFirstLetter(subjects, (s) => s.subject);
const letters = groups.map(([letter]) => letter);

// The collapsed row previews the opening of the description.
const preview = (s: (typeof subjects)[number]) => {
  const text = plain(s.sections[0].items[0]?.text ?? '');
  return text.length > 150 ? text.slice(0, text.lastIndexOf(' ', 150)) + '…' : text;
};
const searchText = (s: (typeof subjects)[number]) =>
  plain([s.subject, ...s.sections.flatMap((sec) => sec.items.map((i) => i.text))].join(' ')).toLowerCase();
const inDepth = (s: (typeof subjects)[number]) => s.sections.length > 1;
---
<Base title="AI Governance Subjects" description="Every subject AI governance has to cover, from agent code execution to workstation security, each explained in plain English.">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">AI Enablement · Subjects</span>
      <h1>Everything AI governance has to cover</h1>
      <p class="lead">
        {subjects.length} governance subjects, one for each thing that needs a rule when AI agents run in production.
        Search by name or by what they cover, then open one to read the full description. Subjects marked <span class="tag depth">In depth</span> have their own page.
      </p>
    </div>
  </section>

  <Lookup
    placeholder="Search subjects, e.g. prompt injection or audit"
    noun={['subject', 'subjects']}
    letters={letters}
    filters={[{ label: 'In depth', tag: 'in-depth' }]}
  />

  <section class="list-section">
    <div class="container">
      <div class="tools">
        <button type="button" class="link-btn" id="expand-all">Expand all</button>
        <span aria-hidden="true">·</span>
        <button type="button" class="link-btn" id="collapse-all">Collapse all</button>
      </div>
      {groups.map(([letter, items]) => (
        <div class="group" id={`letter-${letter.toLowerCase()}`} data-group>
          <h2 class="letter">{letter}</h2>
          {items.map((s) =>
            inDepth(s) ? (
              <a
                class="subject linked"
                id={s.slug}
                href={`/subjects/${s.slug}`}
                data-entry
                data-search={searchText(s)}
                data-tags="in-depth"
              >
                <span class="name">
                  {s.subject}
                  <span class="tag depth">In depth</span>
                </span>
                <span class="preview">{preview(s)}</span>
                <span class="toggle arrow" aria-hidden="true">→</span>
              </a>
            ) : (
              <details class="subject" id={s.slug} data-entry data-search={searchText(s)}>
                <summary>
                  <span class="name">{s.subject}</span>
                  <span class="preview">{preview(s)}</span>
                  <span class="toggle" aria-hidden="true"></span>
                </summary>
                <div class="body">
                  {s.sections.map((sec) => (
                    <div class="sub">
                      <h3>{sec.title}</h3>
                      {runs(sec.items).map((run) =>
                        run.type === 'p' ? (
                          <p set:html={inline(run.text)} />
                        ) : (
                          <ul>{run.items.map((text) => <li set:html={inline(text)} />)}</ul>
                        )
                      )}
                    </div>
                  ))}
                  <a class="permalink" href={`#${s.slug}`}>Link to this subject</a>
                </div>
              </details>
            )
          )}
        </div>
      ))}
      <div id="lookup-empty" class="empty" hidden>
        <p>No subject matches that search.</p>
        <button type="button" id="lookup-clear" class="btn btn-ghost">Clear search</button>
      </div>
      <p class="see-also">
        Not sure what a word means? <a href="/glossary">Look it up in the glossary →</a>
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const all = () => document.querySelectorAll<HTMLDetailsElement>('details.subject:not([hidden])');
  document.getElementById('expand-all')?.addEventListener('click', () => all().forEach((d) => (d.open = true)));
  document.getElementById('collapse-all')?.addEventListener('click', () => all().forEach((d) => (d.open = false)));

  // Open the subject a link points at.
  function openTarget() {
    const target = location.hash && document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView();
    }
  }
  window.addEventListener('hashchange', openTarget);
  openTarget();
</script>

<style>
  .hero { padding-bottom: 2.5rem; }
  .list-section { padding-top: 1.2rem; }
  .tools { display: flex; justify-content: flex-end; gap: 0.5rem; color: var(--muted); font-size: 0.88rem; }
  .link-btn { background: none; border: 0; padding: 0; font: inherit; color: var(--accent-strong); cursor: pointer; }
  :root[data-theme='dark'] .link-btn { color: var(--accent); }
  .link-btn:hover { text-decoration: underline; text-underline-offset: 3px; }
  .group { scroll-margin-top: 12rem; }
  .letter {
    font-size: 1.5rem; color: var(--accent-strong);
    border-bottom: 1px solid var(--border); padding: 1.6rem 0 0.5rem; margin: 0;
  }
  :root[data-theme='dark'] .letter { color: var(--accent); }

  .subject { border-bottom: 1px solid var(--border); scroll-margin-top: 12rem; }
  summary, .linked {
    display: grid; grid-template-columns: minmax(12rem, 17rem) 1fr auto; gap: 0.3rem 2rem; align-items: baseline;
    padding: 1rem 0; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .name, .linked:hover .name { color: var(--accent-strong); }
  :root[data-theme='dark'] summary:hover .name, :root[data-theme='dark'] .linked:hover .name { color: var(--accent); }
  .linked { text-decoration: none; color: var(--text) !important; }
  .arrow { display: grid; place-items: center; font-size: 0.85rem; color: var(--accent-strong); border-color: var(--accent); transition: transform 0.15s; }
  .arrow::before, .arrow::after { display: none; }
  .linked:hover .arrow { transform: translateX(3px); }
  .name { font-weight: 700; transition: color 0.15s; }
  .depth { margin: 0 0 0 0.5rem; font-size: 0.7rem; font-weight: 600; vertical-align: 0.1em; border-color: var(--accent); color: var(--accent-strong); }
  :root[data-theme='dark'] .depth { color: var(--accent); }
  .preview { color: var(--muted); font-size: 0.95rem; }
  .subject[open] .preview { visibility: hidden; }
  .toggle { width: 1.6rem; height: 1.6rem; border: 1px solid var(--border); border-radius: 50%; position: relative; align-self: center; }
  .toggle::before, .toggle::after {
    content: ''; position: absolute; inset: 50% auto auto 50%; width: 0.6rem; height: 2px;
    background: var(--muted); translate: -50% -50%; transition: rotate 0.2s;
  }
  .toggle::after { rotate: 90deg; }
  .subject[open] .toggle::after { rotate: 0deg; }

  .body {
    margin: -0.2rem 0 1.4rem; padding: 1.3rem 1.5rem;
    background: var(--bg-soft); border-radius: var(--radius);
  }
  .sub + .sub { margin-top: 1.3rem; padding-top: 1.3rem; border-top: 1px solid var(--border); }
  .sub h3 {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 0.5rem;
  }
  .sub p, .sub li { max-width: 72ch; }
  .sub p:last-child { margin-bottom: 0; }
  .sub ul { margin: 0 0 1em; padding-left: 1.2rem; }
  .sub ul:last-child { margin-bottom: 0; }
  .sub li { margin-bottom: 0.45rem; }
  .sub li::marker { color: var(--accent); }
  .body :global(code) { font-size: 0.86em; background: var(--bg); padding: 0.05rem 0.35rem; border-radius: 5px; border: 1px solid var(--border); }
  .permalink { display: inline-block; margin-top: 1rem; font-size: 0.85rem; }

  .empty { text-align: center; padding: 3rem 0; color: var(--muted); }
  .see-also { margin-top: 2.5rem; color: var(--muted); }
  @media (max-width: 760px) {
    summary, .linked { grid-template-columns: 1fr auto; }
    .preview { grid-column: 1; grid-row: 2; }
    .toggle { grid-column: 2; grid-row: 1 / span 2; }
    .subject[open] .preview { display: none; }
    .body { padding: 1.1rem; }
  }
</style>
